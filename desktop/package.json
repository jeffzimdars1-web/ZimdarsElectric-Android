{
  "name": "zimdars-electric-pc",
  "productName": "Zimdars Electric",
  "version": "1.0.0",
  "description": "Zimdars Electric for PC",
  "main": "src/main.js",
  "author": "Zimdars Electric LLC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.zimdarselectric.pc",
    "productName": "Zimdars Electric",
    "files": ["src/**/*", "icon.png"],
    "icon": "icon.png",
    "win": { "target": "nsis", "artifactName": "ZimdarsElectric-PC-Setup.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Zimdars Electric" }
  }
}
